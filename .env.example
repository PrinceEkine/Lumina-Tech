# ---------------------------------------------------------------------------
# Kyventis Tech — environment variables
# Copy to .env.local for local dev, and add these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.
# ---------------------------------------------------------------------------

# --- Firebase Admin SDK (server / serverless functions) ---
# From a kyventis-tech service-account JSON (Firebase console →
# Project settings → Service accounts → Generate new private key).
FIREBASE_PROJECT_ID=kyventis-tech
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes; the app converts them to real newlines.
FIREBASE_PRIVATE_KEY=""
# Optional: leave blank to use the project's default Firestore database.
FIREBASE_DATABASE_ID=

# --- Email: Resend (primary provider) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender. Use your own verified domain in production, e.g.
# "Kyventis Tech <hello@kyventis.tech>". The sandbox below only delivers to
# the Resend account owner's email.
CONTACT_FROM_EMAIL="Kyventis Tech <onboarding@resend.dev>"
# Where contact-form submissions are delivered (the studio inbox).
CONTACT_TO_EMAIL=you@kyventis.tech

# --- Email: Gmail SMTP (automatic fallback if RESEND_API_KEY is unset) ---
SMTP_USER=your-address@gmail.com
# A Gmail "App Password", NOT your normal password.
SMTP_PASS=

# --- Optional: Gemini API key (used by vite define at build time) ---
GEMINI_API_KEY=
